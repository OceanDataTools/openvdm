#!/usr/bin/env python3
"""Plugin for ROV data logged by OpenRVDAS.

Matches raw OpenRVDAS log files from an ROV to their parsers, crops the data to
the file's lowering (from Sealog or OpenVDM), and returns the JSON-formatted
plugin data used by OpenVDM's Data Dashboard.
"""

import sys
import os
import json
import fnmatch
import argparse
import logging
from datetime import datetime, timezone
from os.path import dirname, realpath
import requests

sys.path.append(dirname(dirname(dirname(realpath(__file__)))))

from server.lib.openvdm import OpenVDM
from server.lib.openvdm_plugin import OpenVDMPlugin
from server.plugins.parsers.comp_pres_parser import CompPresParser
from server.plugins.parsers.ctd_parser import CTDParser
from server.plugins.parsers.gga_parser import GGAParser
from server.plugins.parsers.o2_parser import O2Parser
from server.plugins.parsers.paro_parser import ParoParser
from server.plugins.parsers.sprint_parser import SprintParser

SEALOG_SERVER_URL = 'http://localhost:8000/sealog-server'
SEALOG_JWT = '<TOKEN>'

# Timestamp formats for lowering start/stop times: Sealog, then OpenVDM.
TIME_FORMATS = ('%Y-%m-%dT%H:%M:%S.%fZ', '%Y/%m/%d %H:%M:%S', '%Y/%m/%d %H:%M')

# -------------------------------------------------------------------------------------
# This array defines the dataTypes collected by the ROV's OpenRVDAS logger and the
# corresponding file regex expression.
# -------------------------------------------------------------------------------------
FILE_TYPE_FILTERS = [
    {"data_type":"rov-comp-pres", "regex": "*/raw/Mech_Comps_Raw-*.txt",   "parser": "CompPres", 'parser_options':{}},
    {"data_type":"rov-ctd",       "regex": "*/raw/CTD_Raw-*.txt",          "parser": "CTD",      'parser_options':{}},
    {"data_type":"rov-o2",        "regex": "*/raw/O2_Raw-*.txt",           "parser": "O2",       'parser_options':{}},
    {"data_type":"rov-paro",      "regex": "*/raw/Paro_Depth_Raw-*.txt",   "parser": "Paro",     'parser_options':{}},
    {"data_type":"rov-sprint",    "regex": "*/raw/Sprint_Raw-*.txt",       "parser": "Sprint",   'parser_options':{}},
    {"data_type":"rov-usbl-pri",  "regex": "*/raw/USBL_Pri_GGA_Raw-*.txt", "parser": "GGA",      'parser_options':{}},
    {"data_type":"rov-usbl-sec",  "regex": "*/raw/USBL_Sec_GGA_Raw-*.txt", "parser": "GGA",      'parser_options':{}},
]


class ROVOpenRVDASPlugin(OpenVDMPlugin):
    """OpenVDM plugin for ROV data logged by OpenRVDAS."""

    PARSER_MAP = {
        "CompPres": CompPresParser,
        "CTD": CTDParser,
        "GGA": GGAParser,
        "O2": O2Parser,
        "Paro": ParoParser,
        "Sprint": SprintParser,
    }

    def __init__(self, lowering=None, use_sealog_api=True):
        """Initialise the plugin.

        Args:
            lowering: Lowering ID to crop every file to. By default each file's
                lowering is taken from its path (``<loweringDataBaseDir>/<loweringID>/``),
                falling back to the current lowering in OpenVDM.
            use_sealog_api: Take each lowering's start/stop times from its
                Sealog milestones instead of its OpenVDM lowering config.
        """

        super().__init__(FILE_TYPE_FILTERS)
        self.sealog_server_url = SEALOG_SERVER_URL
        self.sealog_jwt = SEALOG_JWT
        self.ovdm = OpenVDM()
        self.lowering = lowering
        self.use_sealog_api = use_sealog_api
        self._warehouse_config = None
        self._windows = {}

    def get_lowering_window(self, lowering_id):
        """Return the ``(start_dt, stop_dt)`` window for a lowering.

        Times are UTC-aware datetimes, or ``None`` where no time is available,
        in which case the parsers don't crop on that side. Results are cached
        per lowering.

        Args:
            lowering_id: The lowering ID.

        Returns:
            A ``(start_dt, stop_dt)`` tuple.
        """

        if lowering_id not in self._windows:
            if not lowering_id:
                window = (None, None)
            elif self.use_sealog_api:
                window = self._get_sealog_window(lowering_id)
            else:
                window = self._get_openvdm_window(lowering_id)

            if window == (None, None):
                logging.warning("Could not determine start/stop times for lowering %s; data won't be cropped",
                                lowering_id)
            self._windows[lowering_id] = window

        return self._windows[lowering_id]

    def _get_parsers(self, filepath):
        """Return ``(data_type, parser)`` pairs for the file, set to crop to its lowering."""

        matches = [f for f in self.file_type_filters if fnmatch.fnmatch(filepath, f["regex"])]
        if not matches:
            logging.debug("No file type filters matched %s", filepath)
            return []

        start_dt, stop_dt = self.get_lowering_window(self._lowering_for(filepath))

        parsers = []
        for f in matches:
            parser_name = f.get("parser")
            parser_cls = self.PARSER_MAP.get(parser_name)
            if not parser_cls:
                logging.warning("Unknown parser '%s' for %s", parser_name, filepath)
                continue
            try:
                options = {'start_dt': start_dt, 'stop_dt': stop_dt, **f.get("parser_options", {})}
                parsers.append((f["data_type"], parser_cls(**options)))
            except Exception as exc:  # pylint: disable=broad-exception-caught
                logging.exception("Failed to instantiate parser %s for %s: %s", parser_name, filepath, exc)
        return parsers

    def parse_file(self, filepath):
        """Run every matching parser on the file and return their plugin data by data type."""

        parsers = self._get_parsers(filepath)
        if not parsers:
            logging.debug("No parsers matched file %s", filepath)
            return {}

        results = {}
        for data_type, data_parser in parsers:
            try:
                data_parser.parse(filepath)
                if data_parser.plugin_data:
                    results[data_type] = data_parser.plugin_data
            except Exception as exc:  # pylint: disable=broad-exception-caught
                logging.exception("Parser '%s' failed for file '%s': %s", data_type, filepath, exc)
        return results

    def _get_warehouse_config(self):
        """Return (and cache) OpenVDM's shipboard data warehouse config."""

        if self._warehouse_config is None:
            self._warehouse_config = self.ovdm.get_shipboard_data_warehouse_config()
        return self._warehouse_config

    def _lowering_for(self, filepath):
        """Return the lowering ID to crop *filepath* to.

        An explicit ``lowering`` wins; otherwise the path component after the
        lowering base directory (e.g. ``Vehicle/<loweringID>/...``); otherwise
        the current lowering.
        """

        if self.lowering:
            return self.lowering

        try:
            base_dir = self._get_warehouse_config().get('loweringDataBaseDir')
            parts = os.path.normpath(filepath).split(os.sep)
            if base_dir in parts and parts.index(base_dir) + 1 < len(parts) - 1:
                return parts[parts.index(base_dir) + 1]
        except Exception as err:  # pylint: disable=broad-exception-caught
            logging.debug("Could not determine lowering from path %s: %s", filepath, err)

        return self.ovdm.get_lowering_id()

    def _get_sealog_window(self, lowering_id):
        """Return the lowering's window from Sealog.

        Uses the ``lowering_descending`` / ``lowering_floats_on_surface``
        milestones, falling back to the lowering's ``start_ts`` / ``stop_ts``.
        """

        lowering = self._get_sealog_lowering_by_id(lowering_id)
        if not lowering:
            return None, None

        milestones = (lowering.get('lowering_additional_meta') or {}).get('milestones') or {}
        return (self._parse_time(milestones.get('lowering_descending') or lowering.get('start_ts')),
                self._parse_time(milestones.get('lowering_floats_on_surface') or lowering.get('stop_ts')))

    def _get_openvdm_window(self, lowering_id):
        """Return the lowering's window from its OpenVDM lowering config file."""

        try:
            config = self._get_warehouse_config()
            config_path = os.path.join(config['shipboardDataWarehouseBaseDir'], self.ovdm.get_cruise_id(),
                                       config['loweringDataBaseDir'], lowering_id,
                                       self.ovdm.get_lowering_config_fn())
            with open(config_path, 'r', encoding='utf-8') as config_file:
                lowering_config = json.load(config_file)
        except Exception as err:  # pylint: disable=broad-exception-caught
            logging.debug("Could not read lowering config for %s: %s", lowering_id, err)
            return None, None

        return (self._parse_time(lowering_config.get('loweringStartDate')),
                self._parse_time(lowering_config.get('loweringEndDate')))

    @staticmethod
    def _parse_time(value):
        """Parse a Sealog or OpenVDM timestamp string as a UTC datetime, or return ``None``."""

        if not value:
            return None
        for time_format in TIME_FORMATS:
            try:
                return datetime.strptime(value, time_format).replace(tzinfo=timezone.utc)
            except ValueError:
                continue
        logging.warning("Unrecognised lowering time: %s", value)
        return None

    def _get_sealog_lowering_by_id(self, lowering_id):
        """
        Retrieve the OpenVDM lowering configuration based in the lowering id
        """

        try:
            url = f"{self.sealog_server_url}/api/v1/lowerings?lowering_id={lowering_id}"
            req = requests.get(url, headers={"authorization": self.sealog_jwt}, timeout=5)
            lowering = json.loads(req.text)[0]
            return lowering
        except Exception as err:  # pylint: disable=broad-exception-caught
            logging.warning("Lowering %s not found in Sealog", lowering_id)
            logging.debug(str(err))

        return None


# -------------------------------
# Module-level function for worker
# -------------------------------
def process_file(filepath):
    """
    Module-level wrapper for Gearman worker compatibility.
    """
    rov_plugin = ROVOpenRVDASPlugin()
    return rov_plugin.parse_file(filepath)


# -------------------------------------------------------------------------------------
# Required python code for running the script as a stand-alone utility
# -------------------------------------------------------------------------------------
if __name__ == "__main__":
    parser = argparse.ArgumentParser(description='OpenVDM plugin for ROV_OpenRVDAS')
    parser.add_argument('--dataType', action='store_true',
                        help='return the dataType of the file')
    parser.add_argument('-v', '--verbosity', dest='verbosity',
                        default=0, action='count',
                        help='Increase output verbosity')
    parser.add_argument('--lowering', dest='lowering',
                        default=None, help='lowering to use with the datafile')
    parser.add_argument('dataFile', metavar='dataFile',
                        help='the raw data file to process')

    parsed_args = parser.parse_args()

    ############################
    # Set up logging before we do any other argument parsing (so that we
    # can log problems with argument parsing).

    LOGGING_FORMAT = '%(asctime)-15s %(levelname)s - %(message)s'
    logging.basicConfig(format=LOGGING_FORMAT)

    LOG_LEVELS = {0: logging.WARNING, 1: logging.INFO, 2: logging.DEBUG}
    parsed_args.verbosity = min(parsed_args.verbosity, max(LOG_LEVELS))
    logging.getLogger().setLevel(LOG_LEVELS[parsed_args.verbosity])

    if not os.path.isfile(parsed_args.dataFile):
        logging.error("File not found")
        sys.exit(1)
    elif os.stat(parsed_args.dataFile).st_size == 0:
        logging.warning("File is empty")
        sys.exit(0)

    plugin = ROVOpenRVDASPlugin(lowering=parsed_args.lowering)

    if parsed_args.dataType:
        data_types = plugin.get_data_types(parsed_args.dataFile)
        if not data_types:
            logging.warning("File is of unknown type")
            sys.exit(1)
        print(",".join(sorted(data_types)))
    else:
        jsonSTR = plugin.get_json_str(parsed_args.dataFile)
        if jsonSTR is None:
            logging.warning("Nothing returned from parser")
            sys.exit(1)
        print(jsonSTR)
