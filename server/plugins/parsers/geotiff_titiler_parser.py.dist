#!/usr/bin/env python3
"""Parser for GeoTIFF files served through TiTiler.

Queries a TiTiler server about the supplied GeoTIFF and returns the
JSON-formatted plugin data used by OpenVDM's Data Dashboard: a map tile
visualization, a Geographic Bounds stat, and, for data rasters such as
bathymetry, per-band value ranges and valid-pixel counts.

The file is passed to TiTiler as a URL under the CruiseData web share, so
TiTiler must be able to reach that URL.

Usage::

    geotiff_titiler_parser.py [-h] [-v+] [--cruisedataPath PATH]
                              [--cruisedataURL URL] [--titilerURL URL] <dataFile>
"""

import logging
import os
import sys
from os.path import dirname, realpath

import requests

sys.path.append(dirname(dirname(dirname(dirname(realpath(__file__))))))

from server.lib.openvdm_plugin import OpenVDMParser

INFO_TIMEOUT = 5
STATS_TIMEOUT = 60
DEFAULT_TITILER_URL = 'http://localhost/titiler'
DEFAULT_CRUISEDATA_URL = 'http://localhost/CruiseData'
DEFAULT_CRUISEPATH = '/data/CruiseData'

GEO_ROUNDING = 6
VALUE_ROUNDING = 3

# Bands with these color interpretations hold display imagery (e.g. 0-255
# RGB), so their value ranges aren't meaningful stats.
IMAGERY_COLORINTERP = {'red', 'green', 'blue', 'alpha', 'palette'}


class GeoTIFFParser(OpenVDMParser):
    """OpenVDM parser for GeoTIFF files, using TiTiler for metadata and tiles.

    Attributes:
        titiler_url: Base URL of the TiTiler server.
        cruisedata_url: URL of the CruiseData web share.
        cruisedata_path: Local path of the CruiseData directory; replaced by
            ``cruisedata_url`` to build the URL TiTiler reads the file from.
    """

    def __init__(self, use_openvdm_api: bool = False, cruisedata_path: str | None = None,
                 cruisedata_url: str | None = None, titiler_url: str | None = None) -> None:
        """Initialise the parser.

        Args:
            use_openvdm_api: Look up the CruiseData URL and path from the
                OpenVDM API when they aren't given.
            cruisedata_path: Local CruiseData directory.
            cruisedata_url: URL of the CruiseData web share.
            titiler_url: Base URL of the TiTiler server.
        """
        super().__init__(use_openvdm_api=use_openvdm_api)

        self.titiler_url = titiler_url or DEFAULT_TITILER_URL

        if use_openvdm_api:
            self.cruisedata_url = cruisedata_url or self.openvdm.get_cruisedata_url()
            self.cruisedata_path = cruisedata_path or self.openvdm.get_cruisedata_path()
        else:
            self.cruisedata_url = cruisedata_url or DEFAULT_CRUISEDATA_URL
            self.cruisedata_path = cruisedata_path or DEFAULT_CRUISEPATH

    def _get_info(self, file_url: str) -> tuple[list[float], dict]:
        """Return the file's WGS84 bounds and its TiTiler info.

        Args:
            file_url: URL TiTiler reads the GeoTIFF from.

        Returns:
            The ``[minx, miny, maxx, maxy]`` bounds in decimal degrees, and the
            dataset info (TiTiler's ``/cog/info`` fields).

        Raises:
            Exception: If TiTiler can't be reached or can't read the file.
        """
        # /cog/info returns bounds in the dataset's own CRS; /cog/info.geojson
        # returns them in WGS84 (plus the same info as its properties).
        req = requests.get(f'{self.titiler_url}/cog/info.geojson',
                           params={'url': file_url}, timeout=INFO_TIMEOUT)
        req.raise_for_status()
        res = req.json()
        bounds = [round(bound, GEO_ROUNDING) for bound in res['bbox']]
        return bounds, res.get('properties', {})

    def _add_band_stats(self, file_url: str, info: dict) -> None:
        """Add value-range and valid-pixel stats for each data band.

        Statistics come from TiTiler's ``/cog/statistics``, which computes
        them on a downsampled preview, so they are approximate for large
        rasters. Bands holding display imagery (RGB, alpha, palette) are
        skipped. Failures are logged and otherwise ignored, since these stats
        are optional.

        Args:
            file_url: URL TiTiler reads the GeoTIFF from.
            info: Dataset info from :meth:`_get_info`.
        """
        colorinterp = [ci.lower() for ci in info.get('colorinterp') or []]
        if colorinterp and all(ci in IMAGERY_COLORINTERP for ci in colorinterp):
            logging.debug("Imagery GeoTIFF (%s), skipping band stats", ', '.join(colorinterp))
            return

        try:
            req = requests.get(f'{self.titiler_url}/cog/statistics',
                               params={'url': file_url}, timeout=STATS_TIMEOUT)
            req.raise_for_status()
            stats = req.json()
        except Exception as err:  # pylint: disable=broad-exception-caught
            logging.warning("Unable to retrieve band statistics from TiTiler: %s", err)
            return

        has_nodata = info.get('nodata_type', 'None') != 'None'

        for idx, (band, band_stats) in enumerate(stats.items()):
            if idx < len(colorinterp) and colorinterp[idx] in IMAGERY_COLORINTERP:
                continue

            name = band_stats.get('description') or band
            # Unnamed bands come back as "b1", "b2", ...
            if name == band and band.startswith('b') and band[1:].isdigit():
                name = f'Band {band[1:]}'

            self.add_bounds_stat([round(band_stats['min'], VALUE_ROUNDING),
                                  round(band_stats['max'], VALUE_ROUNDING)], f'{name} Bounds')

            if has_nodata:
                self.add_value_validity_stat([int(band_stats['valid_pixels']),
                                              int(band_stats['masked_pixels'])], f'{name} Validity')

    def process_file(self, filepath: str) -> None:
        """Parse the GeoTIFF and populate the plugin data.

        Args:
            filepath: Path to the GeoTIFF under ``cruisedata_path``.

        Raises:
            Exception: If TiTiler can't return the file's bounds.
        """
        logging.debug("Parsing data file...")
        label = os.path.splitext(os.path.basename(filepath))[0]
        file_url = f"{self.cruisedata_url}{filepath.replace(self.cruisedata_path, '')}"

        try:
            bounds, info = self._get_info(file_url)
        except Exception as err:
            logging.error("Unable to retrieve metadata on file from TiTiler API")
            raise err

        logging.debug("Finished parsing data file")

        logging.debug("Tabulating statistics...")
        self.add_geobounds_stat(bounds)
        self._add_band_stats(file_url, info)

        logging.debug("Building visualization data...")
        self.add_visualization_data({
            "label": label,
            "tileURL": file_url,
            "mapBounds": ','.join(str(bound) for bound in bounds)
        })


# -------------------------------------------------------------------------------------
# Required python code for running the script as a stand-alone utility
# -------------------------------------------------------------------------------------
if __name__ == "__main__":
    import argparse

    parser = argparse.ArgumentParser(description='Parse GeoTiff image data')
    parser.add_argument('-v', '--verbosity', dest='verbosity',
                        default=0, action='count',
                        help='Increase output verbosity')
    parser.add_argument('--cruisedataPath', metavar='cruisedataPath', default=None,
                        help='Path to CruiseData')
    parser.add_argument('--cruisedataURL', metavar='cruisedataURL', default=None,
                        help='URL to CruiseData')
    parser.add_argument('--titilerURL', metavar='titilerURL', default=None,
                        help=f'URL to TiTiler (default: {DEFAULT_TITILER_URL})')
    parser.add_argument('dataFile', metavar='dataFile',
                        help='the raw data file to process')

    parsed_args = parser.parse_args()

    ############################
    # Set up logging before we do any other argument parsing (so that we
    # can log problems with argument parsing).

    LOGGING_FORMAT = '%(asctime)-15s %(levelname)s - %(message)s'
    logging.basicConfig(format=LOGGING_FORMAT)

    LOG_LEVELS = {0: logging.WARNING, 1: logging.INFO, 2: logging.DEBUG}
    parsed_args.verbosity = min(parsed_args.verbosity, max(LOG_LEVELS))
    logging.getLogger().setLevel(LOG_LEVELS[parsed_args.verbosity])

    ovdm_parser = GeoTIFFParser(cruisedata_path=parsed_args.cruisedataPath,
                                cruisedata_url=parsed_args.cruisedataURL,
                                titiler_url=parsed_args.titilerURL)

    try:
        logging.info("Processing file: %s", parsed_args.dataFile)
        ovdm_parser.process_file(parsed_args.dataFile)
        print(ovdm_parser.to_json())
        logging.info("Done!")
    except Exception as err:
        logging.error(str(err))
        raise err
