#!/usr/bin/env python3
"""Parser for Sea-Bird SBE 45 thermosalinograph data.

Parses timestamped log files containing Sea-Bird SBE 45 thermosalinograph
readings (temperature, conductivity, salinity and sound velocity), optionally
with external SBE 38 temperature, and returns the JSON-formatted plugin data
used by OpenVDM's Data Dashboard.
"""

import sys
import logging
from datetime import datetime
from os.path import dirname, realpath
import pandas as pd
import numpy as np
import json

sys.path.append(dirname(dirname(dirname(dirname(realpath(__file__))))))

from server.lib.openvdm_plugin import OpenVDMCSVParser

PROC_COLS = ['date_time','temp_c','cond_Sm','sal_PSU','sv_ms']

FIELDS = [
    'temp_c',
    'cond_Sm',
    'sal_PSU',
    'sv_ms',
    'sbe38_temp_c'
]

ROUNDING = {
    'temp_c': 4,
    'cond_Sm': 5,
    'sal_PSU': 4,
    'sv_ms': 3,
    'sbe38_temp_c': 4
}


class SBE45TSGParser(OpenVDMCSVParser):
    """Parser for Sea-Bird SBE 45 thermosalinograph log files."""

    MAX_DELTA_T = pd.Timedelta('10 seconds')

    def __init__(self, start_dt=None, stop_dt=None, time_format=None,
                 skip_header=False, use_openvdm_api=False, sbe38=False,
                 col_names=False):
        """Initialise the parser.

        Args:
            start_dt: Optional crop start datetime.
            stop_dt: Optional crop stop datetime.
            time_format: ``strptime`` format for timestamps.
            skip_header: Skip the first line of each data file when ``True``.
            use_openvdm_api: Enable OpenVDM API message posting.
            sbe38: The file also includes temperature from an external SBE 38.
            col_names: Data rows include column names.
        """
        self.sbe38 = sbe38
        self.col_names = col_names
        # Build a new list; appending to PROC_COLS would change it for every
        # later instance in the process.
        proc_cols = PROC_COLS + ['sbe38_temp_c'] if sbe38 else list(PROC_COLS)

        super().__init__(proc_cols, proc_cols, start_dt=start_dt, stop_dt=stop_dt,
                         time_format=time_format, skip_header=skip_header,
                         use_openvdm_api=use_openvdm_api)

    def parse(self, filepath):
        """Parse the SBE 45 TSG file and populate the plugin data."""
        raw_data = {col: [] for col in self.proc_cols}
        errors = []

        # -------------------------
        # Read and parse lines
        # -------------------------
        try:
            for lineno, timestamp_str, remainder, fields in self.read_lines_with_timestamps(filepath):
                logging.debug(f"{timestamp_str}{self.timestamp_separator}{remainder}")

                # Map fields to FIELDS
                field_data = dict(zip(FIELDS, fields))

                try:
                    temp_c = float(field_data['temp_c'].split('=')[1] if self.col_names else field_data['temp_c'] ) if field_data['temp_c'] else None
                    cond_Sm = float(field_data['cond_Sm'].split('=')[1] if self.col_names else field_data['cond_Sm']) if field_data['cond_Sm'] else None
                    sal_PSU = float(field_data['sal_PSU'].split('=')[1] if self.col_names else field_data['sal_PSU']) if field_data['sal_PSU'] else None
                    sv_ms = float(field_data['sv_ms'].split('=')[1] if self.col_names else field_data['sv_ms']) if field_data['sv_ms'] else None
                    sbe38_temp_c = float(field_data['sbe38_temp_c'].split('=')[1] if self.col_names else field_data['sbe38_temp_c']) if (self.sbe38 and field_data['sbe38_temp_c']) else None

                    raw_data['date_time'].append(timestamp_str)
                    raw_data['temp_c'].append(temp_c)
                    raw_data['cond_Sm'].append(cond_Sm)
                    raw_data['sal_PSU'].append(sal_PSU)
                    raw_data['sv_ms'].append(sv_ms)
                    if self.sbe38:
                        raw_data['sbe38_temp_c'].append(sbe38_temp_c)

                except Exception as err:
                    errors.append(lineno)
                    logging.debug("Line %s skipped due to parse error: %s", lineno, err)

        except Exception as err:
            logging.error("Failed to read file %s: %s", filepath, err)
            return None

        if not raw_data['date_time']:
            logging.warning("No valid  data in file: %s", filepath)
            return None

        # -------------------------
        # Build DataFrame
        # -------------------------
        df = pd.DataFrame(raw_data)
        df['date_time'] = pd.to_datetime(df['date_time'], errors='coerce')
        if df['date_time'].isna().all():
            logging.error("All timestamps could not be parsed; aborting.")
            return None
        df = df.dropna(subset=['date_time'])
        df = df.set_index('date_time')

        if self.start_dt or self.stop_dt:
            df = self.crop_data(df)
        if df.empty:
            logging.warning("Dataframe empty after cropping: %s", filepath)
            return None

        # -------------------------
        # DeltaT
        # -------------------------
        df['deltaT'] = df.index.to_series().diff()

        # -------------------------
        # Statistics
        # -------------------------
        logging.info("Tabulating statistics...")
        self.add_row_validity_stat([len(df), len(errors)])
        self.add_time_bounds_stat([df.index.min().to_pydatetime(),df.index.max().to_pydatetime()])
        self.add_bounds_stat([round(df['deltaT'].min().total_seconds(),3),
                              round(df['deltaT'].max().total_seconds(),3)], 'DeltaT Bounds', 'seconds')
        self.add_value_validity_stat([len(df[df['deltaT'] <= self.MAX_DELTA_T]),
                                      len(df[df['deltaT'] > self.MAX_DELTA_T])], 'DeltaT Validity')
        self.add_bounds_stat([round(df['temp_c'].min(), ROUNDING['temp_c']),
                              round(df['temp_c'].max(), ROUNDING['temp_c'])], "Temperature Bounds", "C")
        self.add_bounds_stat([round(df['cond_Sm'].min(), ROUNDING['cond_Sm']),
                              round(df['cond_Sm'].max(), ROUNDING['cond_Sm'])], 'Conductivity Bounds', 'S/m')
        self.add_bounds_stat([round(df['sal_PSU'].min(), ROUNDING['sal_PSU']),
                              round(df['sal_PSU'].max(), ROUNDING['sal_PSU'])], 'Salinity Bounds', 'PSU')
        self.add_bounds_stat([round(df['sv_ms'].min(), ROUNDING['sv_ms']),
                              round(df['sv_ms'].max(), ROUNDING['sv_ms'])], 'SV Bounds', 'm/s')
        if self.sbe38:
            self.add_bounds_stat([round(df['sbe38_temp_c'].min(), ROUNDING['sbe38_temp_c']),
                                  round(df['sbe38_temp_c'].max(), ROUNDING['sbe38_temp_c'])], "SBE38 Temp. Bounds", "C")

        # -------------------------
        # Quality tests
        # -------------------------
        logging.info("Running quality tests...")
        quality_checks = [
            ('Rows', len(df)+len(errors), len(errors)),
            ('DeltaT', len(df), len(df[df['deltaT'] > self.MAX_DELTA_T]))
        ]

        for col, total, bad in quality_checks:
            error_rate = bad / total
            if error_rate > 0.25:
                self.add_quality_test_failed(col)
            elif error_rate > 0.10:
                self.add_quality_test_warning(col)
            else:
                self.add_quality_test_passed(col)

        # -------------------------
        # Resample and round
        # -------------------------
        df = self.resample_data(df)
        df = self.round_data(df, ROUNDING)
        df = df.set_index('date_time')

        # -------------------------
        # Visualization
        # -------------------------
        logging.info("Building visualization datasets...")

        for col, unit, label in [('temp_c', 'C', 'Temperature'),
                                 ('cond_Sm', 'S/m', 'Conductivity'),
                                 ('sal_PSU', 'PSU', 'Salinity'),
                                 ('sv_ms', 'm/s', 'SV'),
                                 ('sbe38_temp_c', 'C', 'SBE38 Temp.')]:
            if col == 'sbe38_temp_c' and not self.sbe38:
                continue

            visualizer_data_obj = {'data': [], 'unit': unit, 'label': label}
            for ts, row in df.iterrows():
                if pd.notna(row[col]):
                    ts = pd.Timestamp(ts)
                    if ts.tzinfo is None:
                        ts = ts.tz_localize('UTC')
                    epoch_ms = int(ts.timestamp() * 1000)
                    visualizer_data_obj['data'].append([epoch_ms, row[col]])

            self.add_visualization_data(visualizer_data_obj)

        # -------------------------
        # Send errors to OpenVDM
        # -------------------------
        self.send_error_msg(errors, filepath)

    # -----------------------------
    # CLI hooks for custom arguments
    # -----------------------------
    @classmethod
    def add_cli_arguments(cls, parser):
        """Add SBE 45 TSG-specific command-line options.

        Args:
            parser: The ``argparse.ArgumentParser`` to add the options to.
        """
        parser.add_argument('--sbe38', action='store_true', default=False, help='File includes temp data from external SBE38')
        parser.add_argument('--col_names', action='store_true', default=False, help='Data rows includes column names')

    @classmethod
    def _extract_custom_cli_kwargs(cls, args):
        return {
            'sbe38': getattr(args, 'sbe38', False),
            'col_names': getattr(args, 'col_names', False)
        }

# -------------------------------------------------------------------------------------
# Standalone CLI
# -------------------------------------------------------------------------------------
if __name__ == "__main__":
    SBE45TSGParser.run_cli()
