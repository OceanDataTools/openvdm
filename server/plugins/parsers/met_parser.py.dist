#!/usr/bin/env python3
"""Parser for meteorological sensor data.

Parses comma-separated log files containing atmospheric sensor measurements
(pressure, temperature, humidity, wind speed and direction) and returns the
JSON-formatted plugin data used by OpenVDM's Data Dashboard.
"""

import logging
import sys
from os.path import dirname, realpath
import pandas as pd

sys.path.append(dirname(dirname(dirname(dirname(realpath(__file__))))))

from server.lib.openvdm_plugin import OpenVDMCSVParser

FIELDS = [
    'hdr', 'sensor_date', 'sensor_time', 'air_pres', 'barometer_sensor_height',
    'barometer_quality', 'air_temp', 'temp_sensor_height', 'temp_quality',
    'humidity', 'humidity_sensor_height', 'humidity_quality', 'vector_wind_spd',
    'vector_wind_dir', 'scalar_wind_spd', 'max_wind_spd', 'wind_sensor_height',
    'wind_sensor_quality', 'sw_irradiance', 'sw_irradiance_sensor_height',
    'sw_irradiance_quality', 'lw_irradiance', 'pir_thermopile_voltage',
    'pir_case_temp', 'pir_dome_temp', 'pir_sensor_height', 'checksum',
]
PROC_COLS = ['date_time', 'air_pres', 'air_temp', 'humidity', 'vector_wind_spd', 'vector_wind_dir']

ROUNDING = {
    'air_pres': 1,
    'air_temp': 2,
    'humidity': 1,
    'vector_wind_spd': 1,
    'vector_wind_dir': 1,
}


class MetParser(OpenVDMCSVParser):
    """Parser for meteorological sensor log files."""

    def __init__(self, start_dt=None, stop_dt=None, time_format=None,
                 skip_header=False, use_openvdm_api=False,
                 require_checksum=True, max_delta_t=15):
        """Initialise the parser.

        Args:
            start_dt: Optional crop start datetime.
            stop_dt: Optional crop stop datetime.
            time_format: ``strptime`` format for timestamps.
            skip_header: Skip the first line of each data file when ``True``.
            use_openvdm_api: Enable OpenVDM API message posting.
            require_checksum: Treat a sentence without a checksum as a bad row
                (the default). Set it to ``False`` for instruments that don't
                send one. A checksum that doesn't match is always a bad row
                (#563).
            max_delta_t: Longest expected time between lines, in seconds. The
                default allows for logger jitter on a sentence every 10 s
                (#564).
        """
        self.require_checksum = require_checksum
        self.max_delta_t = pd.Timedelta(seconds=float(max_delta_t))
        super().__init__(None, PROC_COLS, start_dt=start_dt, stop_dt=stop_dt,
                         time_format=time_format, skip_header=skip_header,
                         use_openvdm_api=use_openvdm_api)

    def parse(self, filepath):
        """Parse the met sensor file and return plugin data dict."""
        raw_data = {col: [] for col in self.proc_cols}
        errors = []
        try:
            for lineno, timestamp_str, remainder, fields in self.read_lines_with_timestamps(filepath, errors=errors):
                field_data = dict(zip(FIELDS, fields))
                try:
                    self.check_nmea_sentence(remainder, fields, len(FIELDS), self.require_checksum)
                    air_pres = float(field_data['air_pres'])
                    air_temp = float(field_data['air_temp'])
                    humidity = float(field_data['humidity'])
                    vector_wind_spd = float(field_data['vector_wind_spd'])
                    vector_wind_dir = float(field_data['vector_wind_dir'])
                    raw_data['date_time'].append(timestamp_str)
                    raw_data['air_pres'].append(air_pres)
                    raw_data['air_temp'].append(air_temp)
                    raw_data['humidity'].append(humidity)
                    raw_data['vector_wind_spd'].append(vector_wind_spd)
                    raw_data['vector_wind_dir'].append(vector_wind_dir)
                except Exception as err:
                    errors.append(lineno)
                    logging.debug("Line %s skipped: %s", lineno, err)
        except Exception as err:
            logging.error("Failed to read file %s: %s", filepath, err)
            return None

        if not raw_data['date_time']:
            logging.warning("No valid data in file: %s", filepath)
            return None

        df = pd.DataFrame(raw_data)
        df['date_time'] = pd.to_datetime(df['date_time'], errors='coerce')
        df = df.dropna(subset=['date_time'])
        if df.empty:
            logging.warning("Dataframe empty after filtering: %s", filepath)
            return None

        if self.start_dt or self.stop_dt:
            df = self.crop_data(df)
        if df.empty:
            logging.warning("Dataframe empty after cropping: %s", filepath)
            return None

        df = df.set_index('date_time')
        df['deltaT'] = df.index.to_series().diff()

        self.add_row_validity_stat([len(df), len(errors)])
        self.add_time_bounds_stat([df.index.min().to_pydatetime(), df.index.max().to_pydatetime()])
        self.add_bounds_stat([round(df['deltaT'].min().total_seconds(), 3),
                              round(df['deltaT'].max().total_seconds(), 3)], 'DeltaT Bounds', 'seconds')
        self.add_value_validity_stat([len(df[df['deltaT'] <= self.max_delta_t]),
                                      len(df[df['deltaT'] > self.max_delta_t])], 'DeltaT Validity')
        self.add_bounds_stat([round(df['vector_wind_spd'].min(), ROUNDING['vector_wind_spd']),
                              round(df['vector_wind_spd'].max(), ROUNDING['vector_wind_spd'])], 'Wind Speed Bounds', 'm/s')
        self.add_bounds_stat([round(df['air_temp'].min(), ROUNDING['air_temp']),
                              round(df['air_temp'].max(), ROUNDING['air_temp'])], 'Air Temperature Bounds', 'C')
        self.add_bounds_stat([round(df['air_pres'].min(), ROUNDING['air_pres']),
                              round(df['air_pres'].max(), ROUNDING['air_pres'])], 'Air Pressure Bounds', 'mBar')
        self.add_bounds_stat([round(df['humidity'].min(), ROUNDING['humidity']),
                              round(df['humidity'].max(), ROUNDING['humidity'])], 'Humidity Bounds', '%')

        for name, total, bad in [
            ('Rows', len(df) + len(errors), len(errors)),
            ('DeltaT', len(df), len(df[df['deltaT'] > self.max_delta_t])),
        ]:
            rate = bad / total
            if rate > 0.25:
                self.add_quality_test_failed(name)
            elif rate > 0.10:
                self.add_quality_test_warning(name)
            else:
                self.add_quality_test_passed(name)

        df = self.resample_data(df, angle_cols=['vector_wind_dir'])
        df = self.round_data(df, ROUNDING, angle_cols=['vector_wind_dir'])
        df = df.set_index('date_time')

        for col, unit, label in [
            ('air_pres', 'mBar', 'Air Pressure'),
            ('air_temp', 'C', 'Air Temperature'),
            ('humidity', '%', 'Relative Humidity'),
            ('vector_wind_spd', 'm/s', 'Relative Wind Spd'),
            ('vector_wind_dir', 'deg', 'Relative Wind Dir'),
        ]:
            viz = {'data': [], 'unit': unit, 'label': label}
            for ts, row in df.iterrows():
                if pd.notna(row[col]):
                    ts_obj = pd.Timestamp(ts)
                    if ts_obj.tzinfo is None:
                        ts_obj = ts_obj.tz_localize('UTC')
                    viz['data'].append([int(ts_obj.timestamp() * 1000), row[col]])
            self.add_visualization_data(viz)

        self.send_error_msg(errors, filepath)
        self.plugin_data = self._sanitize_for_json(self.plugin_data)
        return self.plugin_data

    @classmethod
    def add_cli_arguments(cls, parser):
        """Add the parser's command-line options.

        Args:
            parser: The ``argparse.ArgumentParser`` to add the options to.
        """
        parser.add_argument('--allow-missing-checksum', dest='require_checksum', action='store_false',
                            help='read sentences without a checksum (for instruments that '
                                 "don't send one); by default they're bad rows")
        parser.add_argument('--max-delta-t', type=float, default=15,
                            help='longest expected time between lines, in seconds (default: 15)')

    @classmethod
    def _extract_custom_cli_kwargs(cls, args):
        return {
            'require_checksum': getattr(args, 'require_checksum', True),
            'max_delta_t': args.max_delta_t,
        }


if __name__ == "__main__":
    MetParser.run_cli()
