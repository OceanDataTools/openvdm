# ----------------------------------------------------------------------------------- #
#
#         FILE:  openvdm.yaml
#
#  DESCRIPTION:  OpenVDM configuration file, YAML format
#
#         BUGS:
#        NOTES:
#       AUTHOR:  Webb Pinner
#      VERSION:  2.16
#      CREATED:  2016-02-02
#     REVISION:  2025-04-12
#
# ----------------------------------------------------------------------------------- #

# The siteRoot for the OpenVDM web-application/API
siteRoot: "http://127.0.0.1/"

# Shared secret sent by Gearman workers in the X-Worker-Token request header.
# API endpoints that return credentials will only include password fields when
# this token is present and matches WORKER_API_KEY in www/app/Core/Config.php.
# Change this to a strong random value before deploying (e.g. openssl rand -hex 32).
workerApiKey: "change-me-to-a-strong-random-value"

# The vessel this OpenVDM install is on. Saved in each cruise's ovdmConfig.json
# and read by QA tools (e.g. sbe-qa-processing). All fields are optional.
vessel:
    name: ""
    # Optional details of the vessel. The installer offers them from R2R's
    # vessel list for vessels in it (#462).
    #shortName: ""   # e.g. Revelle
    #callSign: ""    # e.g. KAOU
    #imoNumber: ""
    #mmsiNumber: ""
    #unolsID: ""     # e.g. RR
    #length: ""      # meters
    #url: ""         # the vessel's web page
    #owner: ""
    contact:
        institution: ""
        #institutionAcronym: ""  # e.g. SIO
        email: ""
    # Only for vessels that submit data to R2R (Rolling Deck to Repository)
    #r2r:
    #    vesselID: ""     # R2R vessel ID (ICES code), e.g. 33RR
    #    operatorID: ""   # e.g. edu.ucsd.sio
    #    schedulerID: ""  # e.g. org.unols

# The transferInterval defines the interval for performing collectionSystemTransfer.
# The unit is in minutes.
transferInterval: 5

# The gearmanServer is the location and port number for the Gearman server used in
# conjunction with OpenVDM.  The required format is <server>:<port>
gearmanServer: "localhost:4730"

# Whether or not to hide all directories in the CruiseData directory other than the
# current cruise. (True|False)
showOnlyCurrentCruiseDir: False

# Whether or not to move the contents of the PublicData share to the cruise data
# directory. (True|False)
transferPublicData: True

# The cruise README: a description of the cruise and its directory layout, at
# the top of the cruise directory. It's rebuilt whenever the cruise config is
# exported (Setup New Cruise, Edit Cruise, Finalize and Export OpenVDM
# Config). The template is a Jinja2 file; to change it, copy
# server/etc/cruise_readme.md.j2.dist to server/etc/cruise_readme.md.j2 and
# edit the copy (the .dist is used while there's no copy). A relative template
# path is relative to the OpenVDM directory. The filename may use {cruiseID},
# e.g. "{cruiseID}_README.md"; keep the quotes, since a name starting with "{"
# is a YAML error without them. OpenVDM won't replace a file of that name that
# it didn't write.
cruiseReadme:
    enable: True
    filename: README.md
    template: server/etc/cruise_readme.md.j2

# The lowering README: the same for each lowering's directory, rebuilt
# whenever the lowering config is exported (Setup New Lowering, Finalize
# Lowering and Export Lowering Config). Its template is
# server/etc/lowering_readme.md.j2, copied from its .dist like the cruise one.
# The filename may use {cruiseID} and {loweringID}, e.g.
# "{cruiseID}_{loweringID}_README.md" (with the quotes).
loweringReadme:
    enable: True
    filename: README.md
    template: server/etc/lowering_readme.md.j2

# maximum age of transfer log files to retain. String must conform with the python
# datetime.timedelta standard
# logfilePurgeTimedelta: "12 hours"

# The plugins section defines where the plugins processing scripts reside
# and the expected suffix for each processing file.  It should include 2 directives:
# processingScriptDir --> the full path containing the plugins processing scripts
# processingScriptSuffix --> the suffix appended to plugins processing scripts
#     i.e. with SCS_dataDashboard.py the suffix is _dataDashboard.py
plugins:
    pluginDir: "./server/plugins"
    pluginSuffix: "_plugin.py"

# The hooks section contains any additional Gearman tasks that should be performed
# after the successful completion of the primary OpenVDM Gearman task.  Any subsequent
# tasks called with be called as background Gearman tasks so to not interfere with
# OpenVDM's primary operation.
hooks:
    runCollectionSystemTransfer:
        - updateDataDashboard
        - updateMD5Summary
        - postCollectionSystemTransfer
    updateDataDashboard:
        - updateMD5Summary
        - postDataDashboard
    rebuildDataDashboard:
        - updateMD5Summary
        - postDataDashboard
    setupNewCruise:
        - postSetupNewCruise
    setupNewLowering:
        - postSetupNewLowering
    preFinalizeCurrentCruise:
        - preFinalizeCurrentCruise
    finalizeCurrentCruise:
        - postFinalizeCurrentCruise
    preFinalizeCurrentLowering:
        - preFinalizeCurrentLowering
    finalizeCurrentLowering:
        - postFinalizeCurrentLowering

# The postHookCommands section contains any additional commands that should be performed
# after the successful completion of the primary OpenVDM Gearman task.  Any subsequent
# tasks called with be called as background Gearman tasks so to not interfere with
# OpenVDM's primary operation.
postHookCommands:
    postCollectionSystemTransfer:
        # Plot new and updated CTD casts into the CTD_Plots extra directory
        # (bin/plot_ctd_casts.py, copied from its .dist; needs matplotlib)
