# SAMPLE BLOCK --- INDENTS ARE IMPORTANT TO THE YAML-FORMAT ---
#- title: Position
#  page: position
#  view: default
#  cssArray:
#  - leaflet
#  jsArray:
#  - dataDashboardDefault
#  - charts
#  - leaflet
#  placeholderArray:
#  - plotType: map
#    id: map
#    heading: Position
#    dataArray:
#    - dataType: gga
#      visType: geoJSON
#    - dataType: geotiff
#      visType: tms

# Breakdown of SAMPLE BLOCK
# Title of the Tab
#- title: Position

# Internal-use title, this should be all lower-case, no spaces, and unique from the
# "page" values used for other tabs
#  page: position

# The MVC view used to format the tab.  OpenVDM includes a "default" view that can be
# used for displaying maps, and time-series data, and a "lowering" view that shows the
# same for one lowering at a time, chosen from a drop-down (use it with the "lowering"
# js file instead of "dataDashboardDefault"; see the example Lowering tab at the end
# of this file).  Additional custom views can be
# developed and used.  For custom views, specify the filename of the view (which must
# be located in the ./app/views/DataDashboard directory of the OpenVDM web-application)
# minus the php suffix (i.e use "customView" for "customView.php")
#  view: default

# Additional css files to include when rendering the tab.  Only specify the filename of
# the css file (which must be located in the ./app/templates/default/css directory of
# the OpenVDM web-application) minus the .css suffix (i.e use "customCSS" for
# "customCSS.css").
#
# SPECIAL CASES:
# If the view needs to leverage leaflet simple add "leaflet".
#  cssArray:
#  - leaflet

# Additional js files to include when rendering the tab.  Only specify the filename of
# the js file (which must be located in the ./app/templates/default/js directory of
# the OpenVDM web-application) minus the .js suffix (i.e use "customJS" for
# "customJS.js").
#
# SPECIAL CASES:
# If the view needs to leverage leaflet simple add "leaflet".
# If the view needs to leverage charts.js, simple add "charts"
# If the view needs to leverage charts.js and the zoom/pan featurebuild_file_manifest.sh add "charts" AND "charts-zoom"
#  jsArray:
#  - dataDashboardDefault
#  - leaflet
#  - charts
#  - charts-zoom

# Placeholders are the bootstrap-styled panels that contain the <div> blocks where data
# will be visualized that are rendered by the view.
#  placeholderArray:

# The "plotType" defines how the view should render the panel and <div> block
#  - plotType: map

# The "id" specifices the id attribute of the <div> block.  This is usful when needing
# to find/modify the contents of the <div> block using javascript.  The "id" should be
# unique for each placeholder on an individual tab
#    id: map

# The "heading" is the text to display in the panel-header
#    heading: Position

# The "dataArray" is the dashboard data to display within a single <div> block.  Each
# element of this array includes a dashboardData 'dataType' (i.e. 'gga') and a
# 'visType'.  The 'visType' specifies how that data should be rendered (geoJSON vs tms)
#    dataArray:
#    - dataType: gga
#      visType: geoJSON
#    - dataType: geotiff
#      visType: tms

# For "chart" placeholders, the 'visType' is one of:
#   json            - each series against time
#   json-reversedY  - the same, with the y axes reversed (values increase downward)
#   json-inverted   - each series against time, on its side: time runs down the
#                     left (earliest at the top) and the values across
#   json-reversedY-inverted - the same, with the value axes reversed
#   json-profile    - a depth profile: depth down the vertical axis and the other
#                     series across, each on its own x axis, joined in time order.
#                     Optional keys: "depthSeries", the series label to use for
#                     depth (default: Depth), and "profileSeries", the series to
#                     plot across (default: all the others). Give a profile its own
#                     "id" when the same dataType is also charted against time.
#  - plotType: chart
#    id: ctd-profile
#    heading: CTD Profile
#    dataArray:
#    - dataType: ctd
#      visType: json-profile
#      depthSeries: Depth
#      profileSeries: [Temperature, Salinity]
#

- title: Position
  page: position
  view: default
  cssArray:
  - leaflet
  jsArray:
  - dataDashboardDefault
  - charts
  - charts-zoom
  - leaflet
  placeholderArray:
  - plotType: map
    id: map
    heading: Position
    dataArray:
    - dataType: gga
      visType: geoJSON
    - dataType: geotiff
      visType: tms

- title: Weather
  page: weather
  view: default
  jsArray:
  - dataDashboardDefault
  - charts
  - charts-zoom
  placeholderArray:
  - plotType: chart
    id: met
    heading: Meterological Sensor
    dataArray:
    - dataType: met
      visType: json
  - plotType: chart
    id: twind
    heading: Wind Sensor
    dataArray:
    - dataType: twind
      visType: json

- title: Seawater
  page: seawater
  view: default
  jsArray:
  - dataDashboardDefault
  - charts
  - charts-zoom
  placeholderArray:
  - plotType: chart
    id: tsg
    heading: Thermosalinograph Sensor
    dataArray:
    - dataType: tsg
      visType: json
  - plotType: chart
    id: ssv
    heading: Surface Sound Velocity
    dataArray:
    - dataType: ssv
      visType: json

