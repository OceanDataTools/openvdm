{
    "name": "simple-mvc-framework/framework",
    "type": "project",
    "description": "Framework for PHP 5.5+",
    "homepage": "https://github.com/simple-mvc-framework/framework",
    "license": "MIT",
    "authors": [
        {
            "name": "David Carr",
            "email": "dave@daveismyname.com",
            "homepage": "http://daveismyname.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2.0",
        "league/commonmark": "^2.7"
    },
    "autoload": {
        "psr-4": {"": "app/"}
    },
    "scripts": {
        "post-install-cmd": [
            "bash ./post_composer.sh"
        ],
        "post-update-cmd": [
            "bash ./post_composer.sh"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5"
    }
}
