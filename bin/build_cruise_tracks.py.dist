#!/usr/bin/env python3
"""Build GeoJSON and KML ship-track files for a cruise.

Reads dashboard data files produced by OpenVDM plugins for one or more GPS
sources, concatenates the ``LineString`` coordinates across all files, and
writes per-device trackline outputs into the ``Tracklines`` extra directory.

Supported dashboard file formats:

- **Legacy**: ``{ "visualizerData": [...] }``
- **Datatype-keyed**: ``{ "<datatype>": { "visualizerData": [...] } }``

Only ``FeatureCollection`` / ``LineString`` entries are used; non-spatial
visualizer data (e.g. time-series charts) is silently skipped.  When
``coordTimes`` arrays are present they are preserved in GeoJSON output and
converted to ISO-8601 ``<TimeSpan>`` elements in KML output.

GPS sources are configured via an embedded YAML block
(``DEFAULT_GPS_SOURCES_YAML``) that can be overridden by passing a YAML file
with ``--config_file``.

The tracklines go to an OpenVDM extra directory: ``Tracklines``, or the one
named with ``-e``. They're given to OpenVDM's warehouse user (the installer's
OpenVDM user) and added to the cruise's MD5 summary. ``-o OUTPUTDIR`` writes
them to a folder instead, owned by whoever runs the script and not added to
the MD5 summary; ``-e`` and ``-o`` can't be used together.

It also sets the current cruise's bounding box in OpenVDM (``cruiseExtent``,
read by QA tools) from one GPS source's combined track: the one marked
``extent: true`` in the GPS sources, else the first. The whole track is used
on every run, so the extent is recomputed, not merged with the last one. It's
only set when the cruise is OpenVDM's current cruise, and not with
``--no_extent``. If nav-qa-processing's OpenVDM hook sets the extent from its
quality-checked fixes, add ``--no_extent`` to this script's hook so the
quick-look extent doesn't overwrite it.

Usage::

    build_cruise_tracks.py [-h] [-v ...] [-n] [-k | -g] [-c CRUISEID]
                           [-e EXTRA_DIRECTORY | -o OUTPUTDIR]
                           [--config_file FILE] [--no_extent]
                           collectionSystem
"""

import argparse
import json
import logging
import os
import sys
import yaml

from os.path import dirname, realpath
sys.path.append(dirname(dirname(realpath(__file__))))

from server.lib.file_utils import set_owner_group_permissions, output_json_data_to_file
from server.lib.geojson_utils import convert_to_kml, combine_geojson_files, geojson_extent
from server.lib.openvdm import OpenVDM

# Name of the extra directory the trackline files are written to.
TRACKLINE_EXTRA_DIR_NAME = "Tracklines"
# Name of the extra directory holding the data dashboard files and manifest.
DASHBOARD_EXTRA_DIR_NAME = "Dashboard_Data"

# ----------------------------------------------------------------------
# Default GPS source configuration (embedded YAML)
# ----------------------------------------------------------------------

# GPS sources used when no --config_file is given; edit to match this ship.
# Add "extent: true" to the source the cruise's bounding box should come from
# (default: the first).
DEFAULT_GPS_SOURCES_YAML = """
CollectionSystem: OpenRVDAS
GPSSources:
  - device: POSMV
    type: gga
"""

# ----------------------------------------------------------------------
# Configuration & validation
# ----------------------------------------------------------------------

def load_gps_sources_from_yaml(
    *,
    yaml_str: str | None = None,
    yaml_path: str | None = None,
    collection_system: str
) -> list:
    """Parse and validate a GPS sources YAML definition.

    Exactly one of *yaml_str* or *yaml_path* must be provided.  The YAML must
    describe a mapping with ``CollectionSystem`` and ``GPSSources`` keys; the
    ``CollectionSystem`` value must match *collection_system*.  Duplicate device
    names or reused data types raise ``RuntimeError``.

    Args:
        yaml_str: Raw YAML string to parse (mutually exclusive with
            *yaml_path*).
        yaml_path: Path to a YAML file to load (mutually exclusive with
            *yaml_str*).
        collection_system: Expected value of the ``CollectionSystem`` key;
            used to guard against loading a config for the wrong system.

    Returns:
        List of GPS source dicts, each containing ``device`` and ``type``
        string keys.

    Raises:
        RuntimeError: On missing arguments, file-not-found, YAML parse
            errors, schema violations, or ``CollectionSystem`` mismatch.
    """
    if not yaml_str and not yaml_path:
        raise RuntimeError("Either yaml_str or yaml_path must be provided")

    try:
        if yaml_path:
            if not os.path.isfile(yaml_path):
                raise RuntimeError(f"GPS sources YAML not found: {yaml_path}")
            with open(yaml_path, "r", encoding="utf-8") as f:
                data = yaml.safe_load(f)
        else:
            data = yaml.safe_load(yaml_str)
    except yaml.YAMLError as err:
        raise RuntimeError(f"Invalid GPS sources YAML: {err}")

    if not isinstance(data, dict):
        raise RuntimeError("GPS sources YAML must be a mapping")

    if data.get("CollectionSystem") != collection_system:
        raise RuntimeError(
            f"GPS sources CollectionSystem mismatch: "
            f"{data.get('CollectionSystem')} != {collection_system}"
        )

    gps_sources = data.get("GPSSources")
    if not isinstance(gps_sources, list):
        raise RuntimeError("GPSSources must be a list")

    seen_devices = set()
    seen_types = set()

    for src in gps_sources:
        device = src.get("device")
        dtype = src.get("type")

        if not device or not dtype:
            raise RuntimeError(
                "Each GPSSource must define exactly one 'device' and one 'type'"
            )

        if device in seen_devices:
            raise RuntimeError(f"Duplicate GPS device: {device}")

        if dtype in seen_types:
            raise RuntimeError(f"Manifest type reused across devices: {dtype}")

        seen_devices.add(device)
        seen_types.add(dtype)

    return gps_sources


def get_gps_sources(args):
    """Return the GPS source list from a file or the embedded YAML default.

    Args:
        args: Parsed ``argparse.Namespace`` containing ``gps_sources_file`` and
            ``collectionSystem`` attributes.

    Returns:
        List of GPS source dicts validated by
        :func:`load_gps_sources_from_yaml`.
    """

    if args.gps_sources_file:
        logging.info("Loading GPS sources from %s", args.gps_sources_file)
        return load_gps_sources_from_yaml(
            yaml_path=args.gps_sources_file,
            collection_system=args.collectionSystem,
        )

    logging.debug("Using embedded GPS sources")
    return load_gps_sources_from_yaml(
        yaml_str=DEFAULT_GPS_SOURCES_YAML,
        collection_system=args.collectionSystem,
    )

# ----------------------------------------------------------------------
# Manifest handling (authoritative source)
# ----------------------------------------------------------------------

def resolve_manifest_path(openVDM, cruise_base_dir, cruiseID):
    """Locate the dashboard data manifest file for a cruise.

    Args:
        openVDM: Active :class:`~server.lib.openvdm.OpenVDM` instance.
        cruise_base_dir: Warehouse base directory (e.g. ``/data``).
        cruiseID: Current cruise identifier.

    Returns:
        Absolute path to the manifest file.

    Raises:
        RuntimeError: If the manifest filename cannot be retrieved, the
            ``Dashboard_Data`` extra directory is absent, or the manifest file
            does not exist on disk.
    """

    manifest_fn = openVDM.get_data_dashboard_manifest_fn()
    if not manifest_fn:
        raise RuntimeError("OpenVDM returned no manifest filename")

    extra_dir = openVDM.get_required_extra_directory_by_name(DASHBOARD_EXTRA_DIR_NAME)

    if not extra_dir:
        raise RuntimeError(f"Unable to find extra directory: {DASHBOARD_EXTRA_DIR_NAME}")

    manifest_path = os.path.join(
        cruise_base_dir,
        cruiseID,
        extra_dir["destDir"],
        manifest_fn
    )
    if not os.path.isfile(manifest_path):
        raise RuntimeError(f"Manifest not found: {manifest_path}")

    return manifest_path


def load_manifest(manifest_path: str):
    """Load and validate a dashboard data manifest JSON file.

    Args:
        manifest_path: Absolute path to the manifest file.

    Returns:
        List of manifest entry dicts, each containing at least ``type`` and
        ``dd_json`` keys.

    Raises:
        RuntimeError: On JSON parse errors, non-list manifests, or entries
            missing required keys.
    """

    try:
        with open(manifest_path, "r", encoding="utf-8") as f:
            manifest = json.load(f)
    except json.JSONDecodeError as err:
        raise RuntimeError(f"Invalid manifest JSON: {err}")

    if not isinstance(manifest, list):
        raise RuntimeError("Manifest must be a list")

    for entry in manifest:
        if "type" not in entry or "dd_json" not in entry:
            raise RuntimeError("Manifest entry missing 'type' or 'dd_json'")

    return manifest


def get_dd_json_files_for_gps_source(manifest, gps_source, cruise_base_dir):
    """Return dashboard JSON file paths matching a GPS source type.

    Args:
        manifest: Loaded manifest list (from :func:`load_manifest`).
        gps_source: GPS source dict with at least a ``type`` key.
        cruise_base_dir: Warehouse base directory prepended to each ``dd_json``
            entry path.

    Returns:
        Sorted list of absolute file paths for the matching entries.
    """

    wanted_type = gps_source["type"]
    files = []

    for entry in manifest:
        if entry["type"] == wanted_type:
            files.append(os.path.join(cruise_base_dir, entry["dd_json"]))

    return sorted(files)

# ----------------------------------------------------------------------
# Output helpers
# ----------------------------------------------------------------------

def write_outputs(geojson_obj, base_name, cruiseID, tracklineDir, args, outputUser,  # pylint: disable=too-many-arguments,too-many-positional-arguments
                  written=None):
    """Write GeoJSON and/or KML trackline files for one GPS source.

    Files are named ``<cruiseID>_<base_name>_Trackline.json`` / ``.kml``.

    Args:
        geojson_obj: GeoJSON ``FeatureCollection`` dict to serialise.
        base_name: Device name or file stem used to build the output filename.
        cruiseID: Current cruise identifier, used as filename prefix.
        tracklineDir: Directory where output files are written.
        args: Parsed ``argparse.Namespace`` containing ``kml_only``,
            ``geojson_only`` and ``outputDir`` attributes.
        outputUser: Username to ``chown`` each file to, or ``None`` to leave
            ownership as it is (``-o``).
        written: List to append ``(path, existed_before)`` to for each file
            written, for the MD5 summary update.
    """

    if written is None:
        written = []

    if not args.kml_only:
        json_path = os.path.join(
            tracklineDir, f"{cruiseID}_{base_name}_Trackline.json"
        )
        logging.info("Saving %s", json_path)

        existed = os.path.isfile(json_path)
        result = output_json_data_to_file(json_path, geojson_obj)
        if not result["verdict"]:
            logging.error("Write failed: %s", result["reason"])
        else:
            written.append((json_path, existed))
            if outputUser:
                set_owner_group_permissions(outputUser, json_path)

    if not args.geojson_only:
        kml_path = os.path.join(
            tracklineDir, f"{cruiseID}_{base_name}_Trackline.kml"
        )
        logging.info("Saving %s", kml_path)

        existed = os.path.isfile(kml_path)
        try:
            with open(kml_path, "w", encoding="utf-8") as f:
                f.write(convert_to_kml(geojson_obj))
        except OSError as err:
            logging.error("KML write failed: %s", err)
            return

        written.append((kml_path, existed))
        if outputUser:
            set_owner_group_permissions(outputUser, kml_path)

# ----------------------------------------------------------------------
# Core processing
# ----------------------------------------------------------------------

def process_gps_source(gps_source,manifest,cruise_base_dir,cruiseID,  # pylint: disable=too-many-arguments,too-many-positional-arguments,too-many-locals
                       tracklineDir,args,outputUser,written=None):
    """Process one GPS source: find its dashboard files and write tracklines.

    Unless ``--no_combine`` is given, the source's dashboard files are combined
    into a single trackline.

    Args:
        gps_source: GPS source dict with ``device`` and ``type`` keys.
        manifest: Loaded manifest list.
        cruise_base_dir: Warehouse base directory.
        cruiseID: Current cruise identifier.
        tracklineDir: Directory where output files are written.
        args: Parsed ``argparse.Namespace``.
        outputUser: Username to ``chown`` each file to, or ``None`` (``-o``).
        written: List of written files, passed to :func:`write_outputs`.

    Returns:
        dict | None: The combined trackline, or ``None`` with
        ``--no_combine`` or if the source has no usable files.
    """

    logging.info(
        "Processing %s (type=%s)",
        gps_source["device"],
        gps_source["type"],
    )

    files = get_dd_json_files_for_gps_source(
        manifest, gps_source, cruise_base_dir
    )

    if not files:
        logging.warning(
            "No manifest entries found for %s", gps_source["device"]
        )
        return None

    if not args.no_combine:
        combined = combine_geojson_files(
            files, cruiseID, gps_source["device"]
        )
        if not combined:
            logging.error("Failed to combine files for %s", gps_source["device"])
            return None

        write_outputs(
            combined,
            gps_source["device"],
            cruiseID,
            tracklineDir,
            args,
            outputUser,
            written,
        )
        return combined

    # no-combine mode
    for file in files:
        try:
            with open(file, "r", encoding="utf-8") as f:
                data = json.load(f)
            geojson_obj = data["visualizerData"][0]
        except (OSError, KeyError, IndexError, json.JSONDecodeError) as err:
            logging.error("Invalid dashboard file %s: %s", file, err)
            continue

        base_name = os.path.basename(file).split(".")[0]
        write_outputs(
            geojson_obj,
            base_name,
            cruiseID,
            tracklineDir,
            args,
            outputUser,
            written,
        )

    return None


def extent_gps_source(gps_sources):
    """Return the GPS source the cruise's bounding box comes from.

    Args:
        gps_sources: GPS source dicts (from :func:`get_gps_sources`).

    Returns:
        dict: The source marked ``extent: true``, else the first.

    Raises:
        RuntimeError: If more than one source is marked.
    """

    marked = [src for src in gps_sources if src.get("extent") is True]
    if len(marked) > 1:
        raise RuntimeError("Only one GPS source can be marked 'extent: true'")
    return marked[0] if marked else gps_sources[0]


def update_cruise_extent(openvdm, gps_source, combined, manifest, cruise_base_dir, cruise_id):  # pylint: disable=too-many-arguments,too-many-positional-arguments
    """Set the current cruise's bounding box in OpenVDM from a GPS source's track.

    Nothing is set if *cruise_id* isn't OpenVDM's current cruise (e.g. with
    ``-c`` for an old cruise), or if the source has no positions yet.

    Args:
        openvdm: Active :class:`~server.lib.openvdm.OpenVDM` instance.
        gps_source: The GPS source (from :func:`extent_gps_source`).
        combined: Its combined trackline from :func:`process_gps_source`, or
            ``None`` to combine its dashboard files here (``--no_combine``).
        manifest: Loaded manifest list.
        cruise_base_dir: Warehouse base directory.
        cruise_id: The cruise being processed.

    Raises:
        Exception: If OpenVDM refuses the extent or can't be reached.
    """

    if cruise_id != openvdm.get_cruise_id():
        logging.info("%s isn't the current cruise; not setting its extent", cruise_id)
        return

    if combined is None:
        files = get_dd_json_files_for_gps_source(manifest, gps_source, cruise_base_dir)
        combined = combine_geojson_files(files, cruise_id, gps_source["device"]) if files else None

    extent = geojson_extent(combined) if combined else None
    if extent is None:
        logging.warning("No positions from %s yet; the cruise extent isn't set", gps_source["device"])
        return

    logging.info("Setting the cruise extent from %s: %s", gps_source["device"], extent)
    openvdm.set_cruise_extent(extent)

# ----------------------------------------------------------------------
# Setup & entry point
# ----------------------------------------------------------------------

def resolve_extra_directory(openvdm, name, cruise_dir, cruise_id, warehouse_cfg):
    """Return the folder of an OpenVDM extra directory in the cruise directory.

    Args:
        openvdm: Active :class:`~server.lib.openvdm.OpenVDM` instance.
        name: The extra directory's name.
        cruise_dir: The cruise directory.
        cruise_id: The cruise.
        warehouse_cfg: From ``OpenVDM.get_shipboard_data_warehouse_config()``.

    Returns:
        str: The folder's absolute path.

    Raises:
        RuntimeError: If there's no such extra directory, it isn't enabled,
            it's per lowering (``{loweringID}``), or its folder doesn't exist.
    """

    extra_dir = openvdm.get_extra_directory_by_name(name)
    if not extra_dir:
        raise RuntimeError(f"No extra directory named {name}: add it in OpenVDM's Configuration > Extra Directories")
    if str(extra_dir.get("enable")) != "1":
        raise RuntimeError(f"The {name} extra directory isn't enabled")
    dest_dir = extra_dir.get("destDir") or ""
    if "{loweringID}" in dest_dir:
        raise RuntimeError(f"The {name} extra directory is per lowering ({dest_dir}), which isn't supported")
    dest_dir = dest_dir.replace("{cruiseID}", cruise_id) \
                       .replace("{loweringDataBaseDir}", warehouse_cfg["loweringDataBaseDir"]).strip("/")
    folder = os.path.join(cruise_dir, dest_dir)
    if not os.path.isdir(folder):
        raise RuntimeError(f"The {name} extra directory's folder doesn't exist: {folder}")
    return folder


def resolve_cruise_and_dirs(openVDM, args):
    """Resolve the cruise identifier and output directories from OpenVDM.

    Args:
        openVDM: Active :class:`~server.lib.openvdm.OpenVDM` instance.
        args: Parsed ``argparse.Namespace`` containing ``cruiseID``,
            ``collectionSystem``, ``outputDir`` and ``extraDirectory``
            attributes.

    Returns:
        A 4-tuple of ``(cruiseID, cruise_base_dir, tracklineDir, outputUser)``.

    Raises:
        RuntimeError: If the cruise ID cannot be determined, the collection
            system is not found, the extra directory can't be used (see
            :func:`resolve_extra_directory`), or the ``-o`` folder does not
            exist.
    """

    cruiseID = args.cruiseID or openVDM.get_cruise_id()
    if not cruiseID:
        raise RuntimeError("Unable to determine CruiseID")

    collectionSystem = openVDM.get_collection_system_transfer_by_name(
        args.collectionSystem
    )
    if not collectionSystem:
        raise RuntimeError(f"Collection System not found: {args.collectionSystem}")

    warehouse_cfg = openVDM.get_shipboard_data_warehouse_config()
    cruise_base_dir = os.path.join(warehouse_cfg["shipboardDataWarehouseBaseDir"])

    if args.outputDir and not os.path.isdir(args.outputDir):
        raise RuntimeError(f"Trackline directory not found: {args.outputDir}")

    tracklineDir = args.outputDir or resolve_extra_directory(
        openVDM,
        args.extraDirectory or TRACKLINE_EXTRA_DIR_NAME,
        os.path.join(cruise_base_dir, cruiseID),
        cruiseID,
        warehouse_cfg,
    )

    # Files in an extra directory belong to OpenVDM's warehouse user; -o
    # output keeps whoever wrote it
    outputUser = None if args.outputDir else warehouse_cfg["shipboardDataWarehouseUsername"]

    return cruiseID, cruise_base_dir, tracklineDir, outputUser


def main():  # pylint: disable=too-many-locals
    """Parse arguments and build cruise trackline files."""

    parser = argparse.ArgumentParser(
        description="build cruise tracklines post-dashboard processing"
    )
    parser.add_argument("-v", "--verbosity", default=0, action="count")
    parser.add_argument("-n", "--no_combine", action="store_true")
    parser.add_argument("-k", "--kml_only", action="store_true")
    parser.add_argument("-g", "--geojson_only", action="store_true")
    parser.add_argument("-c", dest="cruiseID")
    output = parser.add_mutually_exclusive_group()
    output.add_argument("-e", "--extra_directory", dest="extraDirectory",
                        help=f"OpenVDM extra directory to write the tracklines to (default: {TRACKLINE_EXTRA_DIR_NAME})")
    output.add_argument("-o", dest="outputDir",
                        help="folder to write the tracklines to instead of an extra directory; "
                             "they aren't added to the MD5 summary")
    parser.add_argument("--config_file", dest="gps_sources_file")
    parser.add_argument("--no_extent", action="store_true",
                        help="don't set the cruise's bounding box in OpenVDM")
    parser.add_argument("collectionSystem")

    args = parser.parse_args()

    LOGGING_FORMAT = "%(asctime)-15s %(levelname)s - %(message)s"
    logging.basicConfig(format=LOGGING_FORMAT)
    logging.getLogger().setLevel(
        [logging.WARNING, logging.INFO, logging.DEBUG][
            min(args.verbosity, 2)
        ]
    )

    openVDM = OpenVDM()

    try:
        cruiseID, cruise_base_dir, tracklineDir, outputUser = (
            resolve_cruise_and_dirs(openVDM, args)
        )
        gps_sources = get_gps_sources(args)
        extent_source = extent_gps_source(gps_sources)

        manifest_path = resolve_manifest_path(openVDM, cruise_base_dir, cruiseID)
        manifest = load_manifest(manifest_path)
    except RuntimeError as err:
        logging.error(str(err))
        sys.exit(1)

    logging.info("Using manifest: %s", manifest_path)

    extent_track = None
    written = []
    for gps_source in gps_sources:
        combined = process_gps_source(gps_source,manifest,cruise_base_dir,cruiseID,
                                      tracklineDir,args,outputUser,written)
        if gps_source is extent_source:
            extent_track = combined

    failures = []
    if not args.no_extent:
        try:
            update_cruise_extent(openVDM, extent_source, extent_track, manifest, cruise_base_dir, cruiseID)
        except Exception as err:  # pylint: disable=broad-exception-caught
            failures.append(f"Unable to set the cruise extent: {err}")

    # Files in an extra directory are part of the cruise; -o folders aren't
    if written and not args.outputDir:
        try:
            openVDM.update_md5_summary(new=[path for path, existed in written if not existed],
                                       updated=[path for path, existed in written if existed],
                                       cruise_id=cruiseID)
        except Exception as err:  # pylint: disable=broad-exception-caught
            failures.append(f"Unable to queue the MD5 summary update for the tracklines: {err}")

    if failures:
        print("\n".join(failures), file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
