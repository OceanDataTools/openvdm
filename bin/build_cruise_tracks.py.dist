#!/usr/bin/env python3
"""Build GeoJSON and KML ship-track files for a cruise.

Reads dashboard data files produced by OpenVDM plugins for one or more position
sources, concatenates the ``LineString`` coordinates across all files, and
writes per-device trackline outputs into the ``Tracklines`` extra directory.

Supported dashboard file formats:

- **Legacy**: ``{ "visualizerData": [...] }``
- **Datatype-keyed**: ``{ "<datatype>": { "visualizerData": [...] } }``

Only ``FeatureCollection`` / ``LineString`` entries are used; non-spatial
visualizer data (e.g. time-series charts) is silently skipped.  When
``coordTimes`` arrays are present they are preserved in GeoJSON output and
converted to ISO-8601 ``<TimeSpan>`` elements in KML output.

Position sources are configured via an embedded YAML block
(``DEFAULT_POSITION_SOURCES_YAML``) that can be overridden by passing a YAML file
with ``--position-sources``.

The tracklines go to an OpenVDM extra directory: ``Tracklines``, or the one
named with ``-e``. They're given to OpenVDM's warehouse user (the installer's
OpenVDM user) and added to the cruise's MD5 summary. ``-o OUTPUTDIR`` writes
them to a folder instead, owned by whoever runs the script and not added to
the MD5 summary; ``-e`` and ``-o`` can't be used together.

It also sets the current cruise's bounding box in OpenVDM (``cruiseExtent``,
read by QA tools) from one position source's combined track: the one marked
``extent: true`` in the position sources, else the first. The whole track is used
on every run, so the extent is recomputed, not merged with the last one. It's
only set when the cruise is OpenVDM's current cruise, and not with
``--no-extent``. If nav-qa-processing's OpenVDM hook sets the extent from its
quality-checked fixes, add ``--no-extent`` to this script's hook so the
quick-look extent doesn't overwrite it.

The shared trackline code is in ``server/lib/tracks.py``; this script adds
the cruise's ID, manifest location, default position sources and extent.

Usage::

    build_cruise_tracks.py [-h] [-v ...] [-n] [-k | -g] [-c CRUISEID]
                           [-e EXTRA_DIRECTORY | -o OUTPUTDIR]
                           [--position-sources FILE] [--no-extent]
                           collectionSystem
"""

import argparse
import logging
import os
import sys

from os.path import dirname, realpath
sys.path.append(dirname(dirname(realpath(__file__))))

from server.lib.geojson_utils import combine_geojson_files, geojson_extent  # noqa: E402  pylint: disable=wrong-import-position
from server.lib.openvdm import OpenVDM  # noqa: E402  pylint: disable=wrong-import-position
from server.lib.tracks import (  # noqa: E402  pylint: disable=wrong-import-position
    TRACKLINE_EXTRA_DIR_NAME, add_output_arguments, get_dd_json_files_for_position_source,
    get_position_sources, load_manifest, process_position_source, queue_md5_update,
    resolve_extra_directory, resolve_manifest_path, setup_logging,
)

# ----------------------------------------------------------------------
# Default position source configuration (embedded YAML)
# ----------------------------------------------------------------------

# Position sources used when no --position-sources is given; edit to match this ship.
# Add "extent: true" to the source the cruise's bounding box should come from
# (default: the first).
DEFAULT_POSITION_SOURCES_YAML = """
CollectionSystem: OpenRVDAS
PositionSources:
  - device: POSMV
    type: gga
"""

# ----------------------------------------------------------------------
# Cruise extent
# ----------------------------------------------------------------------

def extent_position_source(position_sources):
    """Return the position source the cruise's bounding box comes from.

    Args:
        position_sources: Position source dicts (from :func:`~server.lib.tracks.get_position_sources`).

    Returns:
        dict: The source marked ``extent: true``, else the first.

    Raises:
        RuntimeError: If more than one source is marked.
    """

    marked = [src for src in position_sources if src.get("extent") is True]
    if len(marked) > 1:
        raise RuntimeError("Only one position source can be marked 'extent: true'")
    return marked[0] if marked else position_sources[0]


def update_cruise_extent(openvdm, position_source, combined, manifest, cruise_base_dir, cruise_id):  # pylint: disable=too-many-arguments,too-many-positional-arguments
    """Set the current cruise's bounding box in OpenVDM from a position source's track.

    Nothing is set if *cruise_id* isn't OpenVDM's current cruise (e.g. with
    ``-c`` for an old cruise), or if the source has no positions yet.

    Args:
        openvdm: Active :class:`~server.lib.openvdm.OpenVDM` instance.
        position_source: The position source (from :func:`extent_position_source`).
        combined: Its combined trackline from
            :func:`~server.lib.tracks.process_position_source`, or ``None`` to
            combine its dashboard files here (``--no-combine``).
        manifest: Loaded manifest list.
        cruise_base_dir: Warehouse base directory.
        cruise_id: The cruise being processed.

    Raises:
        Exception: If OpenVDM refuses the extent or can't be reached.
    """

    if cruise_id != openvdm.get_cruise_id():
        logging.info("%s isn't the current cruise; not setting its extent", cruise_id)
        return

    if combined is None:
        files = get_dd_json_files_for_position_source(manifest, position_source, cruise_base_dir)
        combined = combine_geojson_files(files, cruise_id, position_source["device"]) if files else None

    extent = geojson_extent(combined) if combined else None
    if extent is None:
        logging.warning("No positions from %s yet; the cruise extent isn't set", position_source["device"])
        return

    logging.info("Setting the cruise extent from %s: %s", position_source["device"], extent)
    openvdm.set_cruise_extent(extent)

# ----------------------------------------------------------------------
# Setup & entry point
# ----------------------------------------------------------------------

def resolve_cruise_and_dirs(openvdm, args):
    """Resolve the cruise and the output directory from OpenVDM.

    Args:
        openvdm: Active :class:`~server.lib.openvdm.OpenVDM` instance.
        args: Parsed ``argparse.Namespace`` containing ``cruiseID``,
            ``collectionSystem``, ``outputDir`` and ``extraDirectory``
            attributes.

    Returns:
        A 4-tuple of ``(cruise_id, cruise_base_dir, trackline_dir, output_user)``;
        *output_user* is ``None`` for ``-o`` output.

    Raises:
        RuntimeError: If the cruise ID cannot be determined, the collection
            system is not found, the extra directory can't be used (see
            :func:`~server.lib.tracks.resolve_extra_directory`), or the
            ``-o`` folder does not exist.
    """

    cruise_id = args.cruiseID or openvdm.get_cruise_id()
    if not cruise_id:
        raise RuntimeError("Unable to determine CruiseID")

    if not openvdm.get_collection_system_transfer_by_name(args.collectionSystem):
        raise RuntimeError(f"Collection System not found: {args.collectionSystem}")

    warehouse_cfg = openvdm.get_shipboard_data_warehouse_config()
    cruise_base_dir = warehouse_cfg["shipboardDataWarehouseBaseDir"]

    if args.outputDir and not os.path.isdir(args.outputDir):
        raise RuntimeError(f"Trackline directory not found: {args.outputDir}")

    trackline_dir = args.outputDir or resolve_extra_directory(
        openvdm, args.extraDirectory or TRACKLINE_EXTRA_DIR_NAME,
        os.path.join(cruise_base_dir, cruise_id), cruise_id, warehouse_cfg,
    )

    # Files in an extra directory belong to OpenVDM's warehouse user; -o
    # output keeps whoever wrote it
    output_user = None if args.outputDir else warehouse_cfg["shipboardDataWarehouseUsername"]

    return cruise_id, cruise_base_dir, trackline_dir, output_user


def main():  # pylint: disable=too-many-locals
    """Parse arguments and build cruise trackline files."""

    parser = argparse.ArgumentParser(
        description="build cruise tracklines post-dashboard processing"
    )
    parser.add_argument("-v", "--verbosity", default=0, action="count")
    parser.add_argument("-n", "--no-combine", action="store_true")
    parser.add_argument("-k", "--kml-only", action="store_true")
    parser.add_argument("-g", "--geojson-only", action="store_true")
    parser.add_argument("-c", dest="cruiseID")
    add_output_arguments(parser)
    parser.add_argument("--position-sources", dest="position_sources_file")
    parser.add_argument("--no-extent", action="store_true",
                        help="don't set the cruise's bounding box in OpenVDM")
    parser.add_argument("collectionSystem")

    args = parser.parse_args()
    setup_logging(args.verbosity)

    openvdm = OpenVDM()

    try:
        cruise_id, cruise_base_dir, trackline_dir, output_user = resolve_cruise_and_dirs(openvdm, args)
        position_sources = get_position_sources(args, DEFAULT_POSITION_SOURCES_YAML)
        extent_source = extent_position_source(position_sources)

        manifest_path = resolve_manifest_path(openvdm, cruise_base_dir, cruise_id)
        manifest = load_manifest(manifest_path)
    except RuntimeError as err:
        logging.error(str(err))
        sys.exit(1)

    logging.info("Using manifest: %s", manifest_path)

    extent_track = None
    written = []
    for position_source in position_sources:
        combined = process_position_source(position_source, manifest, cruise_base_dir, cruise_id,
                                           trackline_dir, args, output_user, written)
        if position_source is extent_source:
            extent_track = combined

    failures = []
    if not args.no_extent:
        try:
            update_cruise_extent(openvdm, extent_source, extent_track, manifest, cruise_base_dir, cruise_id)
        except Exception as err:  # pylint: disable=broad-exception-caught
            failures.append(f"Unable to set the cruise extent: {err}")

    # Files in an extra directory are part of the cruise; -o folders aren't
    if written and not args.outputDir:
        message = queue_md5_update(openvdm, written, cruise_id)
        if message:
            failures.append(message)

    if failures:
        print("\n".join(failures), file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
