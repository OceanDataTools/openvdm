#!/usr/bin/env python3
"""Build GeoJSON and KML ship-track files for a cruise.

Reads dashboard data files produced by OpenVDM plugins for one or more position
sources, concatenates the ``LineString`` coordinates across all files, and
writes per-device trackline outputs into the ``Tracklines`` extra directory.

Supported dashboard file formats:

- **Legacy**: ``{ "visualizerData": [...] }``
- **Datatype-keyed**: ``{ "<datatype>": { "visualizerData": [...] } }``

Only ``FeatureCollection`` / ``LineString`` entries are used; non-spatial
visualizer data (e.g. time-series charts) is silently skipped.  When
``coordTimes`` arrays are present they are preserved in GeoJSON output and
converted to ISO-8601 ``<TimeSpan>`` elements in KML output.

Position sources are configured via an embedded YAML block
(``DEFAULT_POSITION_SOURCES_YAML``) that can be overridden by passing a YAML file
with ``--position-sources``.

The tracklines go to an OpenVDM extra directory: ``Tracklines``, or the one
named with ``-e``. They're given to OpenVDM's warehouse user (the installer's
OpenVDM user) and added to the cruise's MD5 summary. ``-o OUTPUTDIR`` writes
them to a folder instead, owned by whoever runs the script and not added to
the MD5 summary; ``-e`` and ``-o`` can't be used together. ``-u USERNAME``
gives ``-o`` output to that user.

The 2.16.0 options ``--no_combine``, ``--kml_only``, ``--geojson_only``,
``--config_file`` and ``-u/--username`` still work, but print a warning: they
are deprecated and will be removed in OpenVDM 2.17. Use ``--no-combine``,
``--kml-only``, ``--geojson-only`` and ``--position-sources``; 2.17 has no
``-u`` (``-o`` output keeps whoever wrote it).

The shared trackline code is in ``server/lib/tracks.py``; this script adds
the cruise's ID, manifest location and default position sources.

Usage::

    build_cruise_tracks.py [-h] [-v ...] [-n] [-k | -g] [-c CRUISEID]
                           [-e EXTRA_DIRECTORY | -o OUTPUTDIR] [-u USERNAME]
                           [--position-sources FILE]
                           collectionSystem
"""

import argparse
import logging
import os
import sys

import requests

from os.path import dirname, realpath
sys.path.append(dirname(dirname(realpath(__file__))))

from server.lib.openvdm import OpenVDM  # noqa: E402  pylint: disable=wrong-import-position
from server.lib.tracks import (  # noqa: E402  pylint: disable=wrong-import-position
    TRACKLINE_EXTRA_DIR_NAME, add_output_arguments, get_position_sources, load_manifest,
    process_position_source, queue_md5_update, resolve_extra_directory, resolve_manifest_path,
    setup_logging,
)

# ----------------------------------------------------------------------
# Default position source configuration (embedded YAML)
# ----------------------------------------------------------------------

# Position sources used when no --position-sources is given; edit to match this ship.
DEFAULT_POSITION_SOURCES_YAML = """
CollectionSystem: OpenRVDAS
PositionSources:
  - device: POSMV
    type: gga
"""

# ----------------------------------------------------------------------
# Deprecated 2.16.0 options
# ----------------------------------------------------------------------

# Title of the OpenVDM message about deprecated options in this script's hook
DEPRECATION_MESSAGE_TITLE = "build_cruise_tracks.py uses deprecated options"


class DeprecatedOption(argparse.Action):
    """An option's 2.16.0 name, which still works but warns that 2.17 removes it.

    For a flag (``nargs=0``) the destination is set to ``True``; otherwise to
    the option's value. The warning is printed on stderr and added to the
    namespace's ``deprecated_options`` list, for
    :func:`report_deprecated_options`.
    """

    def __init__(self, option_strings, dest, instead, **kwargs):
        """Create the action.

        Args:
            option_strings: The deprecated option's names.
            dest: The attribute it sets, shared with its replacement.
            instead: The end of the warning, after "removed in OpenVDM
                2.17;", e.g. ``"use --no-combine"``.
            **kwargs: Other :class:`argparse.Action` arguments. Unless given,
                the option is left out of ``--help`` and sets no default (its
                replacement's applies).
        """
        kwargs.setdefault("help", argparse.SUPPRESS)
        kwargs.setdefault("default", argparse.SUPPRESS)
        super().__init__(option_strings, dest, **kwargs)
        self.instead = instead

    def __call__(self, parser, namespace, values, option_string=None):
        """Warn on stderr, record the warning and set the destination."""
        warning = f"{option_string} is deprecated and will be removed in OpenVDM 2.17; {self.instead}"
        print(f"Warning: {warning}", file=sys.stderr)
        namespace.deprecated_options.append(warning)
        setattr(namespace, self.dest, True if self.nargs == 0 else values)


def report_deprecated_options(openvdm, warnings):
    """Post the deprecation warnings as an OpenVDM message.

    A hook's warnings on stderr aren't shown in OpenVDM when it succeeds, so
    they're posted as a message too. Nothing is posted if an unread message
    with the same title is among OpenVDM's 10 most recent unread messages, so
    a hook that runs after every data dashboard update doesn't fill the list.
    A failure to check or post is logged and otherwise ignored.

    Args:
        openvdm: Active :class:`~server.lib.openvdm.OpenVDM` instance.
        warnings: The warnings (from :class:`DeprecatedOption`).
    """
    if not warnings:
        return
    try:
        response = requests.get(f"{openvdm.config['siteRoot']}api/messages/getRecentMessages", timeout=5)
        response.raise_for_status()
        if any(msg.get("messageTitle") == DEPRECATION_MESSAGE_TITLE for msg in response.json()):
            return
        openvdm.send_msg(DEPRECATION_MESSAGE_TITLE,
                         "\n".join(warnings) + "\nUpdate this script's hook in openvdm.yaml before upgrading.")
    except Exception as err:  # pylint: disable=broad-exception-caught
        logging.warning("Unable to post the deprecation warning to OpenVDM: %s", err)

# ----------------------------------------------------------------------
# Setup & entry point
# ----------------------------------------------------------------------

def resolve_cruise_and_dirs(openvdm, args):
    """Resolve the cruise and the output directory from OpenVDM.

    Args:
        openvdm: Active :class:`~server.lib.openvdm.OpenVDM` instance.
        args: Parsed ``argparse.Namespace`` containing ``cruiseID``,
            ``collectionSystem``, ``outputDir``, ``extraDirectory`` and
            ``username`` attributes.

    Returns:
        A 4-tuple of ``(cruise_id, cruise_base_dir, trackline_dir, output_user)``;
        for ``-o`` output *output_user* is ``-u``'s user, or ``None``.

    Raises:
        RuntimeError: If the cruise ID cannot be determined, the collection
            system is not found, the extra directory can't be used (see
            :func:`~server.lib.tracks.resolve_extra_directory`), or the
            ``-o`` folder does not exist.
    """

    cruise_id = args.cruiseID or openvdm.get_cruise_id()
    if not cruise_id:
        raise RuntimeError("Unable to determine CruiseID")

    if not openvdm.get_collection_system_transfer_by_name(args.collectionSystem):
        raise RuntimeError(f"Collection System not found: {args.collectionSystem}")

    warehouse_cfg = openvdm.get_shipboard_data_warehouse_config()
    cruise_base_dir = warehouse_cfg["shipboardDataWarehouseBaseDir"]

    if args.outputDir and not os.path.isdir(args.outputDir):
        raise RuntimeError(f"Trackline directory not found: {args.outputDir}")

    trackline_dir = args.outputDir or resolve_extra_directory(
        openvdm, args.extraDirectory or TRACKLINE_EXTRA_DIR_NAME,
        os.path.join(cruise_base_dir, cruise_id), cruise_id, warehouse_cfg,
    )

    # Files in an extra directory belong to OpenVDM's warehouse user; -o
    # output keeps whoever wrote it, unless -u is given
    output_user = args.username if args.outputDir else warehouse_cfg["shipboardDataWarehouseUsername"]

    return cruise_id, cruise_base_dir, trackline_dir, output_user


def main():  # pylint: disable=too-many-locals
    """Parse arguments and build cruise trackline files."""

    parser = argparse.ArgumentParser(
        description="build cruise tracklines post-dashboard processing"
    )
    parser.add_argument("-v", "--verbosity", default=0, action="count")
    parser.add_argument("-n", "--no-combine", dest="no_combine", action="store_true")
    parser.add_argument("-k", "--kml-only", dest="kml_only", action="store_true")
    parser.add_argument("-g", "--geojson-only", dest="geojson_only", action="store_true")
    parser.add_argument("-c", dest="cruiseID")
    add_output_arguments(parser)
    parser.add_argument("--position-sources", dest="position_sources_file")

    # 2.16.0 names, removed in 2.17
    for old, new, dest in (("--no_combine", "--no-combine", "no_combine"),
                           ("--kml_only", "--kml-only", "kml_only"),
                           ("--geojson_only", "--geojson-only", "geojson_only")):
        parser.add_argument(old, dest=dest, action=DeprecatedOption, nargs=0, instead=f"use {new}")
    parser.add_argument("--config_file", dest="position_sources_file", action=DeprecatedOption,
                        instead="use --position-sources")
    parser.add_argument("-u", "--username", action=DeprecatedOption, default=None,
                        instead="-o output will keep whoever wrote it",
                        help="owner of the files written with -o (deprecated, removed in 2.17)")
    parser.add_argument("collectionSystem")

    parser.set_defaults(deprecated_options=[])

    args = parser.parse_args()
    setup_logging(args.verbosity)

    openvdm = OpenVDM()
    report_deprecated_options(openvdm, args.deprecated_options)

    try:
        cruise_id, cruise_base_dir, trackline_dir, output_user = resolve_cruise_and_dirs(openvdm, args)
        position_sources = get_position_sources(args, DEFAULT_POSITION_SOURCES_YAML)

        manifest_path = resolve_manifest_path(openvdm, cruise_base_dir, cruise_id)
        manifest = load_manifest(manifest_path)
    except RuntimeError as err:
        logging.error(str(err))
        sys.exit(1)

    logging.info("Using manifest: %s", manifest_path)

    written = []
    for position_source in position_sources:
        process_position_source(position_source, manifest, cruise_base_dir, cruise_id,
                                trackline_dir, args, output_user, written)

    # Files in an extra directory are part of the cruise; -o folders aren't
    if written and not args.outputDir:
        message = queue_md5_update(openvdm, written, cruise_id)
        if message:
            print(message, file=sys.stderr)
            sys.exit(1)


if __name__ == "__main__":
    main()
