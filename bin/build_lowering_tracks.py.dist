#!/usr/bin/env python3
"""Build GeoJSON and KML trackline files for a lowering.

Analogous to ``build_cruise_tracks.py`` but scoped to a single lowering.
Reads dashboard data files for one or more navigation/positioning sources
(e.g. USBL-PRI, USBL-SEC, SPRINT) that were processed by the OpenVDM plugin
for the specified collection system, concatenates their ``LineString``
coordinates, and writes per-device trackline outputs into the ``Tracklines``
extra directory.

Supported dashboard file formats:

- **Legacy**: ``{ "visualizerData": [...] }``
- **Datatype-keyed**: ``{ "<datatype>": { "visualizerData": [...] } }``

Only ``FeatureCollection`` / ``LineString`` entries are used; non-spatial
visualizer data (e.g. time-series charts) is silently skipped.  When
``coordTimes`` arrays are present they are preserved in GeoJSON output and
converted to ISO-8601 ``<TimeSpan>`` elements in KML output.

Navigation sources are configured via an embedded YAML block
(``DEFAULT_POSITION_SOURCES_YAML``) that can be overridden by passing a YAML file
with ``--position-sources``.

The tracklines go to an OpenVDM extra directory: ``Tracklines``, or the one
named with ``-e``. A lowering-level extra directory is inside the lowering
(``<loweringDataBaseDir>/<loweringID>/<destDir>``); a cruise-level one may use
``{loweringID}`` in its path. They're given to OpenVDM's warehouse user (the
installer's OpenVDM user) and added to the cruise's MD5 summary.
``-o OUTPUTDIR`` writes them to a folder instead, owned by whoever runs the
script and not added to the MD5 summary; ``-e`` and ``-o`` can't be used
together.

It also sets the current lowering's bounding box in OpenVDM
(``loweringExtent``, saved in each lowering's config file) from one position
source's combined track: the one marked ``extent: true`` in the position
sources, else the first. The whole track is used on every run, so the extent
is recomputed, not merged with the last one. It's only set when the lowering
is OpenVDM's current lowering, and not with ``--no-extent``.

The shared trackline code, including picking the extent's position source
and computing the extent, is in ``server/lib/tracks.py``; this script adds the
lowering's ID, manifest location and default position sources, and stores the
lowering extent.

Usage::

    build_lowering_tracks.py [-h] [-v ...] [-n] [-k | -g] [-l LOWERINGID]
                             [-e EXTRA_DIRECTORY | -o OUTPUTDIR]
                             [--position-sources FILE] [--no-extent]
                             collectionSystem
"""

import argparse
import logging
import os
import sys

from os.path import dirname, realpath
sys.path.append(dirname(dirname(realpath(__file__))))

from server.lib.openvdm import OpenVDM  # noqa: E402  pylint: disable=wrong-import-position
from server.lib.tracks import (  # noqa: E402  pylint: disable=wrong-import-position
    TRACKLINE_EXTRA_DIR_NAME, add_output_arguments, extent_position_source, get_position_sources,
    load_manifest, process_position_source, queue_md5_update, resolve_extra_directory,
    resolve_manifest_path, setup_logging, track_extent,
)

# ----------------------------------------------------------------------
# Default position source configuration (embedded YAML)
# ----------------------------------------------------------------------

# Position sources used when no --position-sources file is given; edit to match this vehicle.
# They apply to the collection system the hook names; add
# "CollectionSystem: <name>" to tie them to one. Add "extent: true" to the
# source the lowering's bounding box should come from (default: the first).
DEFAULT_POSITION_SOURCES_YAML = """
PositionSources:
  - device: USBL-PRI
    type: usbl_pri_gga
  - device: USBL-SEC
    type: usbl_sec_gga
  - device: SPRINT
    type: sprint
"""

# ----------------------------------------------------------------------
# Lowering extent
# ----------------------------------------------------------------------

def update_lowering_extent(openvdm, position_source, combined, manifest, cruise_base_dir, lowering_id):  # pylint: disable=too-many-arguments,too-many-positional-arguments
    """Set the current lowering's bounding box in OpenVDM from a position source's track.

    Nothing is set if *lowering_id* isn't OpenVDM's current lowering (e.g.
    with ``-l`` for an earlier one), or if the source has no positions yet.

    Args:
        openvdm: Active :class:`~server.lib.openvdm.OpenVDM` instance.
        position_source: The position source (from
            :func:`~server.lib.tracks.extent_position_source`).
        combined: Its combined trackline from
            :func:`~server.lib.tracks.process_position_source`, or ``None`` to
            combine its dashboard files here (``--no-combine``).
        manifest: Loaded manifest list.
        cruise_base_dir: Warehouse base directory.
        lowering_id: The lowering being processed.

    Raises:
        Exception: If OpenVDM refuses the extent or can't be reached.
    """

    if lowering_id != openvdm.get_lowering_id():
        logging.info("%s isn't the current lowering; not setting its extent", lowering_id)
        return

    extent = track_extent(position_source, combined, manifest, cruise_base_dir, lowering_id)
    if extent is None:
        logging.warning("No positions from %s yet; the lowering extent isn't set", position_source["device"])
        return

    logging.info("Setting the lowering extent from %s: %s", position_source["device"], extent)
    openvdm.set_lowering_extent(extent)

# ----------------------------------------------------------------------
# Setup & entry point
# ----------------------------------------------------------------------

def resolve_lowering_and_dirs(openvdm, args) -> tuple:
    """Resolve the cruise, the lowering and the output directory from OpenVDM.

    Args:
        openvdm: Active :class:`~server.lib.openvdm.OpenVDM` instance.
        args: Parsed ``argparse.Namespace`` containing ``loweringID``,
            ``collectionSystem``, ``outputDir`` and ``extraDirectory``
            attributes.

    Returns:
        A 6-tuple of ``(cruise_id, lowering_id, cruise_base_dir,
        lowering_base_dir, trackline_dir, output_user)``; *output_user* is
        ``None`` for ``-o`` output.

    Raises:
        RuntimeError: If the cruise or lowering ID cannot be determined, the
            collection system is not found or is not lowering-scoped, the
            extra directory can't be used (see
            :func:`~server.lib.tracks.resolve_extra_directory`), or the ``-o``
            folder does not exist.
    """
    cruise_id = openvdm.get_cruise_id()
    if not cruise_id:
        raise RuntimeError("Unable to determine CruiseID")

    lowering_id = args.loweringID or openvdm.get_lowering_id()
    if not lowering_id:
        raise RuntimeError(f"Unable to find LoweringID within Cruise: {cruise_id}")

    collection_system = openvdm.get_collection_system_transfer_by_name(args.collectionSystem)
    if not collection_system:
        raise RuntimeError(f"Collection System not found: {args.collectionSystem}")

    if collection_system["cruiseOrLowering"] != "1":
        raise RuntimeError(f"Collection System: {args.collectionSystem} is not related to a lowering")

    warehouse_cfg = openvdm.get_shipboard_data_warehouse_config()
    cruise_base_dir = warehouse_cfg["shipboardDataWarehouseBaseDir"]
    lowering_base_dir = warehouse_cfg["loweringDataBaseDir"]

    if args.outputDir and not os.path.isdir(args.outputDir):
        raise RuntimeError(f"Trackline directory not found: {args.outputDir}")

    trackline_dir = args.outputDir or resolve_extra_directory(
        openvdm, args.extraDirectory or TRACKLINE_EXTRA_DIR_NAME,
        os.path.join(cruise_base_dir, cruise_id), cruise_id, warehouse_cfg, lowering_id,
    )

    # Files in an extra directory belong to OpenVDM's warehouse user; -o
    # output keeps whoever wrote it
    output_user = None if args.outputDir else warehouse_cfg["shipboardDataWarehouseUsername"]

    return cruise_id, lowering_id, cruise_base_dir, lowering_base_dir, trackline_dir, output_user


def main() -> None:  # pylint: disable=too-many-locals
    """Parse arguments and build lowering trackline files."""
    parser = argparse.ArgumentParser(
        description="build lowering tracklines post-dashboard processing"
    )
    parser.add_argument("-v", "--verbosity", default=0, action="count")
    parser.add_argument("-n", "--no-combine", dest="no_combine", action="store_true")

    group = parser.add_mutually_exclusive_group()
    group.add_argument("-k", "--kml-only", dest="kml_only", action="store_true")
    group.add_argument("-g", "--geojson-only", dest="geojson_only", action="store_true")

    parser.add_argument("-l", dest="loweringID")
    add_output_arguments(parser)
    parser.add_argument("--position-sources", dest="position_sources_file")
    parser.add_argument("--no-extent", action="store_true",
                        help="don't set the lowering's bounding box in OpenVDM")
    parser.add_argument("collectionSystem")

    args = parser.parse_args()
    setup_logging(args.verbosity)

    openvdm = OpenVDM()

    try:
        cruise_id, lowering_id, cruise_base_dir, lowering_base_dir, trackline_dir, output_user = (
            resolve_lowering_and_dirs(openvdm, args)
        )
        position_sources = get_position_sources(args, DEFAULT_POSITION_SOURCES_YAML)
        extent_source = extent_position_source(position_sources)

        manifest_path = resolve_manifest_path(
            openvdm, cruise_base_dir, cruise_id, os.path.join(lowering_base_dir, lowering_id)
        )
        manifest = load_manifest(manifest_path)
    except RuntimeError as err:
        logging.error(str(err))
        sys.exit(1)

    logging.info("Using manifest: %s", manifest_path)

    extent_track = None
    written = []
    for position_source in position_sources:
        combined = process_position_source(position_source, manifest, cruise_base_dir, lowering_id,
                                           trackline_dir, args, output_user, written)
        if position_source is extent_source:
            extent_track = combined

    failures = []
    if not args.no_extent:
        try:
            update_lowering_extent(openvdm, extent_source, extent_track, manifest, cruise_base_dir, lowering_id)
        except Exception as err:  # pylint: disable=broad-exception-caught
            failures.append(f"Unable to set the lowering extent: {err}")

    # Files in an extra directory are part of the cruise; -o folders aren't
    if written and not args.outputDir:
        message = queue_md5_update(openvdm, written, cruise_id)
        if message:
            failures.append(message)

    if failures:
        print("\n".join(failures), file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
